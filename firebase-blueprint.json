{
  "entities": {
    "Book": {
      "title": "Book",
      "description": "Published ebook or question bank item in the catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "isPublished": { "type": "boolean" },
        "isDeleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "publishAt": { "type": "string", "format": "date-time" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "urlSlug": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[a-z0-9\\-]+$" },
        "seoDescription": { "type": "string", "maxLength": 500 },
        "fullDescription": { "type": "string", "maxLength": 50000 },
        "type": { "type": "string", "maxLength": 64 },
        "language": { "type": "string", "maxLength": 64 },
        "publisher": { "type": "string", "maxLength": 160 },
        "authorName": { "type": "string", "maxLength": 160 },
        "tags": { "type": "array", "description": "Taxonomy tags (max 25)" },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3, "pattern": "^[A-Z]{3}$" },
        "listPrice": { "type": "number" },
        "buyPrice": { "type": "number" },
        "sampleMarkdownUrl": { "type": "string", "maxLength": 2048 },
        "samplePdfUrl": { "type": "string", "maxLength": 2048 },
        "fullMarkdownStoragePath": { "type": "string", "maxLength": 1024 },
        "fullPdfStoragePath": { "type": "string", "maxLength": 1024 }
      },
      "required": [
        "id",
        "isPublished",
        "isDeleted",
        "title",
        "urlSlug",
        "type",
        "language",
        "currency",
        "listPrice",
        "buyPrice"
      ]
    },
    "ExamPack": {
      "title": "ExamPack",
      "description": "Published mock test series pack in ExamPackDocument collection.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "isPublished": { "type": "boolean" },
        "isDeleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "publishAt": { "type": "string", "format": "date-time" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "urlSlug": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[a-z0-9\\-]+$" },
        "seoDescription": { "type": "string", "maxLength": 500 },
        "fullDescription": { "type": "string", "maxLength": 50000 },
        "type": { "type": "string", "maxLength": 64 },
        "language": { "type": "string", "maxLength": 64 },
        "publisher": { "type": "string", "maxLength": 160 },
        "authorName": { "type": "string", "maxLength": 160 },
        "tags": { "type": "array", "description": "Taxonomy tags (max 25)" },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3, "pattern": "^[A-Z]{3}$" },
        "listPrice": { "type": "number" },
        "buyPrice": { "type": "number" },
        "totalMocktest": { "type": "number" },
        "MocktestTitles": { "type": "array", "description": "Syllabus list of mock tests" },
        "fullJsonStoragePath": { "type": "string", "maxLength": 1024 },
        "sampleJsonStoragePath": { "type": "string", "maxLength": 1024 }
      },
      "required": [
        "id",
        "isPublished",
        "isDeleted",
        "title",
        "urlSlug",
        "type",
        "language",
        "currency",
        "listPrice",
        "buyPrice",
        "totalMocktest"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Non-PII user workspace profile document.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "preferredView": { "type": "string", "enum": ["grid", "list"], "maxLength": 10 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "preferredView", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII subcollection document for user contact metadata.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 254 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "UserPurchase": {
      "title": "UserPurchase",
      "description": "Verified entitlement record unlocking a Book or ExamPack for a user.",
      "type": "object",
      "properties": {
        "purchaseId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "itemId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "collectionName": { "type": "string", "enum": ["books", "ExamPackDocument"], "maxLength": 32 },
        "urlSlug": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[a-z0-9\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "type": { "type": "string", "minLength": 1, "maxLength": 64 },
        "authorName": { "type": "string", "maxLength": 160 },
        "language": { "type": "string", "maxLength": 64 },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3, "pattern": "^[A-Z]{3}$" },
        "listPrice": { "type": "number" },
        "paidPrice": { "type": "number" },
        "totalMocktest": { "type": "number" },
        "paymentProvider": { "type": "string", "enum": ["razorpay", "free"], "maxLength": 16 },
        "razorpayOrderId": { "type": "string", "minLength": 10, "maxLength": 64, "pattern": "^order_[a-zA-Z0-9]+$" },
        "razorpayPaymentId": { "type": "string", "minLength": 10, "maxLength": 64, "pattern": "^pay_[a-zA-Z0-9]+$" },
        "status": { "type": "string", "enum": ["completed"], "maxLength": 16 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "purchaseId",
        "userId",
        "itemId",
        "collectionName",
        "urlSlug",
        "title",
        "type",
        "currency",
        "listPrice",
        "paidPrice",
        "status",
        "createdAt"
      ]
    },
    "UserCartItem": {
      "title": "UserCartItem",
      "description": "Authenticated user cart item synced from localStorage composite key.",
      "type": "object",
      "properties": {
        "cartKey": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "itemId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "collectionName": { "type": "string", "enum": ["books", "ExamPackDocument"], "maxLength": 32 },
        "urlSlug": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[a-z0-9\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "authorName": { "type": "string", "maxLength": 160 },
        "language": { "type": "string", "maxLength": 64 },
        "type": { "type": "string", "minLength": 1, "maxLength": 64 },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3, "pattern": "^[A-Z]{3}$" },
        "listPrice": { "type": "number" },
        "buyPrice": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "cartKey",
        "userId",
        "itemId",
        "collectionName",
        "urlSlug",
        "title",
        "type",
        "currency",
        "listPrice",
        "buyPrice",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserWishlistItem": {
      "title": "UserWishlistItem",
      "description": "Authenticated user saved wishlist item for a Book or ExamPack.",
      "type": "object",
      "properties": {
        "wishlistKey": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "itemId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "collectionName": { "type": "string", "enum": ["books", "ExamPackDocument"], "maxLength": 32 },
        "urlSlug": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[a-z0-9\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "authorName": { "type": "string", "maxLength": 160 },
        "language": { "type": "string", "maxLength": 64 },
        "type": { "type": "string", "minLength": 1, "maxLength": 64 },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3, "pattern": "^[A-Z]{3}$" },
        "listPrice": { "type": "number" },
        "buyPrice": { "type": "number" },
        "totalMocktest": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "wishlistKey",
        "userId",
        "itemId",
        "collectionName",
        "urlSlug",
        "title",
        "type",
        "currency",
        "listPrice",
        "buyPrice",
        "createdAt"
      ]
    },
    "ItemReview": {
      "title": "ItemReview",
      "description": "Public non-PII learner rating and review for a published Book or ExamPack.",
      "type": "object",
      "properties": {
        "reviewId": { "type": "string", "minLength": 5, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetKey": { "type": "string", "minLength": 3, "maxLength": 100, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "collectionName": { "type": "string", "enum": ["books", "ExamPackDocument"], "maxLength": 32 },
        "itemId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "urlSlug": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[a-z0-9\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "rating": { "type": "number", "description": "Integer star rating from 1 to 5" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "comment": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "verifiedPurchase": { "type": "boolean" },
        "status": { "type": "string", "enum": ["published"], "maxLength": 16 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "reviewId",
        "targetKey",
        "collectionName",
        "itemId",
        "urlSlug",
        "userId",
        "authorName",
        "rating",
        "comment",
        "verifiedPurchase",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserExamAttempt": {
      "title": "UserExamAttempt",
      "description": "Historical user exam set attempt storing scores, responses, section and question time telemetry, solution review outcomes, deterministic after-exam analysis, and learner feedback.",
      "type": "object",
      "properties": {
        "attemptId": { "type": "string", "minLength": 5, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "packId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "examSlug": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[a-z0-9\\-]+$" },
        "examTitle": { "type": "string", "minLength": 1, "maxLength": 300 },
        "setId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "setTitle": { "type": "string", "minLength": 1, "maxLength": 300 },
        "mode": { "type": "string", "enum": ["trial", "full"], "maxLength": 16 },
        "totalScore": { "type": "number", "description": "Net marks scored in this attempt" },
        "maxScore": { "type": "number", "description": "Maximum marks possible in the exam set" },
        "scorePct": { "type": "number", "description": "Net percentage of maxScore (0..100)" },
        "accuracyPct": { "type": "number", "description": "Accuracy percentage on attempted questions (0..100)" },
        "attemptPct": { "type": "number", "description": "Percentage of total questions attempted (0..100)" },
        "totalQuestions": { "type": "number", "description": "Total questions in the exam set (1..500)" },
        "totalAttempted": { "type": "number", "description": "Total attempted questions (0..500)" },
        "totalCorrect": { "type": "number", "description": "Total correct answers (0..500)" },
        "totalPartial": { "type": "number", "description": "Total partially correct MSQ answers (0..500)" },
        "totalWrong": { "type": "number", "description": "Total wrong answers (0..500)" },
        "totalUnattempted": { "type": "number", "description": "Total unattempted questions (0..500)" },
        "positiveMarksEarned": { "type": "number", "description": "Gross positive marks earned" },
        "negativeMarksLost": { "type": "number", "description": "Gross negative marks deducted" },
        "totalTimeSpentMs": { "type": "number", "description": "Total dwell time spent in milliseconds" },
        "avgTimePerAttemptedMs": { "type": "number", "description": "Average time spent per attempted question in milliseconds" },
        "responses": { "type": "object", "description": "Map of questionId to selected option ID(s) or NAT numeric string (max 500 keys)" },
        "telemetry": { "type": "object", "description": "Map of questionId to { timeSpentMs, visits } telemetry (max 500 keys)" },
        "markedForReview": { "type": "object", "description": "Map of questionId to boolean marked-for-review flag (max 500 keys)" },
        "sectionBreakdown": { "type": "array", "description": "Ordered list of section performance and time telemetry maps (1..30 sections)" },
        "questionBreakdown": { "type": "array", "description": "Ordered list of per-question evaluation, dwell time, revisit, and key summaries (1..500 questions)" },
        "performanceInsights": { "type": "object", "description": "Deterministic post-exam diagnostic analysis and actionable takeaways" },
        "perceivedDifficulty": { "type": "string", "enum": ["easy", "moderate", "challenging", "tough"], "maxLength": 24 },
        "pacingFeedback": { "type": "string", "enum": ["comfortable", "balanced", "rushed", "time_shortage"], "maxLength": 24 },
        "reflectionNote": { "type": "string", "maxLength": 2000 },
        "startedAtIso": { "type": "string", "minLength": 10, "maxLength": 64 },
        "completedAtIso": { "type": "string", "minLength": 10, "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "attemptId",
        "userId",
        "packId",
        "examSlug",
        "examTitle",
        "setId",
        "setTitle",
        "mode",
        "totalScore",
        "maxScore",
        "scorePct",
        "accuracyPct",
        "attemptPct",
        "totalQuestions",
        "totalAttempted",
        "totalCorrect",
        "totalPartial",
        "totalWrong",
        "totalUnattempted",
        "positiveMarksEarned",
        "negativeMarksLost",
        "totalTimeSpentMs",
        "avgTimePerAttemptedMs",
        "responses",
        "telemetry",
        "markedForReview",
        "sectionBreakdown",
        "questionBreakdown",
        "performanceInsights",
        "startedAtIso",
        "completedAtIso",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/books/{bookId}": {
      "schema": { "$ref": "#/entities/Book" },
      "description": "Read-only public catalog of published ebooks and question banks."
    },
    "/ExamPackDocument/{examId}": {
      "schema": { "$ref": "#/entities/ExamPack" },
      "description": "Read-only public catalog of published exam packs and mock test series."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/ItemReview" },
      "description": "Public published learner ratings and reviews (1 review per user per catalog item, zero PII)."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-only non-PII user profile preferences."
    },
    "/users/{userId}/private/{infoId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Strictly isolated PII subcollection storing verified user email."
    },
    "/users/{userId}/purchases/{purchaseId}": {
      "schema": { "$ref": "#/entities/UserPurchase" },
      "description": "Immutable completed entitlement records owned by the user."
    },
    "/users/{userId}/cart/{cartKey}": {
      "schema": { "$ref": "#/entities/UserCartItem" },
      "description": "Owner-scoped active shopping cart items."
    },
    "/users/{userId}/wishlist/{wishlistKey}": {
      "schema": { "$ref": "#/entities/UserWishlistItem" },
      "description": "Owner-scoped saved wishlist books and exam packs."
    },
    "/users/{userId}/examAttempts/{attemptId}": {
      "schema": { "$ref": "#/entities/UserExamAttempt" },
      "description": "Owner-scoped historical exam set attempts with immutable telemetry, solution review outcomes, diagnostic analysis, and editable learner feedback."
    }
  }
}
