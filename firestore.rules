rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-Deny Catch-All
    match /{document=**} { allow read, write: if false; }

    // Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.uid == userId;
    }

    function hasParentUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        || existsAfter(/databases/$(database)/documents/users/$(userId));
    }

    function hasValidReviewPurchaseProof(data) {
      return data.verifiedPurchase == false
        || exists(/databases/$(database)/documents/users/$(request.auth.uid)/purchases/$(data.collectionName + '_' + data.itemId));
    }

    // Entity Validation Blueprints (Anti-Update-Gap)
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'preferredView', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'preferredView', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && data.preferredView is string
        && data.preferredView.size() <= 10
        && (data.preferredView == 'grid' || data.preferredView == 'list')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'updatedAt'])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.email == request.auth.token.email
        && data.updatedAt is timestamp;
    }

    function isValidPaymentProof(data) {
      return (
        (
          data.paidPrice > 0
          && 'paymentProvider' in data
          && data.paymentProvider is string
          && data.paymentProvider.size() <= 16
          && data.paymentProvider == 'razorpay'
          && 'razorpayOrderId' in data
          && data.razorpayOrderId is string
          && data.razorpayOrderId.size() >= 10
          && data.razorpayOrderId.size() <= 64
          && data.razorpayOrderId.matches('^order_[a-zA-Z0-9]+$')
          && 'razorpayPaymentId' in data
          && data.razorpayPaymentId is string
          && data.razorpayPaymentId.size() >= 10
          && data.razorpayPaymentId.size() <= 64
          && data.razorpayPaymentId.matches('^pay_[a-zA-Z0-9]+$')
        )
        ||
        (
          data.paidPrice == 0
          && (!('paymentProvider' in data) || (data.paymentProvider is string && data.paymentProvider.size() <= 16 && data.paymentProvider == 'free'))
          && !('razorpayOrderId' in data)
          && !('razorpayPaymentId' in data)
        )
      );
    }

    function isValidUserPurchase(data, purchaseId) {
      return data.keys().hasAll([
          'purchaseId',
          'userId',
          'itemId',
          'collectionName',
          'urlSlug',
          'title',
          'type',
          'currency',
          'listPrice',
          'paidPrice',
          'status',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'purchaseId',
          'userId',
          'itemId',
          'collectionName',
          'urlSlug',
          'title',
          'type',
          'authorName',
          'language',
          'currency',
          'listPrice',
          'paidPrice',
          'totalMocktest',
          'paymentProvider',
          'razorpayOrderId',
          'razorpayPaymentId',
          'status',
          'createdAt'
        ])
        && data.purchaseId is string
        && data.purchaseId.size() >= 1
        && data.purchaseId.size() <= 128
        && data.purchaseId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.purchaseId == purchaseId
        && data.userId is string
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && data.itemId is string
        && data.itemId.size() >= 1
        && data.itemId.size() <= 128
        && data.itemId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.collectionName is string
        && data.collectionName.size() <= 32
        && (data.collectionName == 'books' || data.collectionName == 'ExamPackDocument')
        && data.urlSlug is string
        && data.urlSlug.size() >= 1
        && data.urlSlug.size() <= 200
        && data.urlSlug.matches('^[a-z0-9\\-]+$')
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 300
        && data.type is string
        && data.type.size() >= 1
        && data.type.size() <= 64
        && (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 160))
        && (!('language' in data) || (data.language is string && data.language.size() <= 64))
        && data.currency is string
        && data.currency.size() == 3
        && data.currency.matches('^[A-Z]{3}$')
        && (data.listPrice is int || data.listPrice is float)
        && data.listPrice >= 0
        && (data.paidPrice is int || data.paidPrice is float)
        && data.paidPrice >= 0
        && data.listPrice >= data.paidPrice
        && (!('totalMocktest' in data) || (data.totalMocktest is int && data.totalMocktest >= 0))
        && isValidPaymentProof(data)
        && data.status is string
        && data.status.size() <= 16
        && data.status == 'completed'
        && data.createdAt is timestamp;
    }

    function isValidUserCartItem(data, cartKey) {
      return data.keys().hasAll([
          'cartKey',
          'userId',
          'itemId',
          'collectionName',
          'urlSlug',
          'title',
          'type',
          'currency',
          'listPrice',
          'buyPrice',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'cartKey',
          'userId',
          'itemId',
          'collectionName',
          'urlSlug',
          'title',
          'authorName',
          'language',
          'type',
          'currency',
          'listPrice',
          'buyPrice',
          'createdAt',
          'updatedAt'
        ])
        && data.cartKey is string
        && data.cartKey.size() >= 3
        && data.cartKey.size() <= 128
        && data.cartKey.matches('^[a-zA-Z0-9_\\-]+$')
        && data.cartKey == cartKey
        && data.userId is string
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && data.itemId is string
        && data.itemId.size() >= 1
        && data.itemId.size() <= 128
        && data.itemId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.collectionName is string
        && data.collectionName.size() <= 32
        && (data.collectionName == 'books' || data.collectionName == 'ExamPackDocument')
        && data.urlSlug is string
        && data.urlSlug.size() >= 1
        && data.urlSlug.size() <= 200
        && data.urlSlug.matches('^[a-z0-9\\-]+$')
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 300
        && (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 160))
        && (!('language' in data) || (data.language is string && data.language.size() <= 64))
        && data.type is string
        && data.type.size() >= 1
        && data.type.size() <= 64
        && data.currency is string
        && data.currency.size() == 3
        && data.currency.matches('^[A-Z]{3}$')
        && (data.listPrice is int || data.listPrice is float)
        && data.listPrice >= 0
        && (data.buyPrice is int || data.buyPrice is float)
        && data.buyPrice >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserWishlistItem(data, wishlistKey) {
      return data.keys().hasAll([
          'wishlistKey',
          'userId',
          'itemId',
          'collectionName',
          'urlSlug',
          'title',
          'type',
          'currency',
          'listPrice',
          'buyPrice',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'wishlistKey',
          'userId',
          'itemId',
          'collectionName',
          'urlSlug',
          'title',
          'authorName',
          'language',
          'type',
          'currency',
          'listPrice',
          'buyPrice',
          'totalMocktest',
          'createdAt'
        ])
        && data.wishlistKey is string
        && data.wishlistKey.size() >= 3
        && data.wishlistKey.size() <= 128
        && data.wishlistKey.matches('^[a-zA-Z0-9_\\-]+$')
        && data.wishlistKey == wishlistKey
        && data.userId is string
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && data.itemId is string
        && data.itemId.size() >= 1
        && data.itemId.size() <= 128
        && data.itemId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.collectionName is string
        && data.collectionName.size() <= 32
        && (data.collectionName == 'books' || data.collectionName == 'ExamPackDocument')
        && data.urlSlug is string
        && data.urlSlug.size() >= 1
        && data.urlSlug.size() <= 200
        && data.urlSlug.matches('^[a-z0-9\\-]+$')
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 300
        && (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 160))
        && (!('language' in data) || (data.language is string && data.language.size() <= 64))
        && data.type is string
        && data.type.size() >= 1
        && data.type.size() <= 64
        && data.currency is string
        && data.currency.size() == 3
        && data.currency.matches('^[A-Z]{3}$')
        && (data.listPrice is int || data.listPrice is float)
        && data.listPrice >= 0
        && (data.buyPrice is int || data.buyPrice is float)
        && data.buyPrice >= 0
        && (!('totalMocktest' in data) || (data.totalMocktest is int && data.totalMocktest >= 0))
        && data.createdAt is timestamp;
    }

    function isValidItemReview(data, reviewId) {
      return data.keys().hasAll([
          'reviewId',
          'targetKey',
          'collectionName',
          'itemId',
          'urlSlug',
          'userId',
          'authorName',
          'rating',
          'comment',
          'verifiedPurchase',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'reviewId',
          'targetKey',
          'collectionName',
          'itemId',
          'urlSlug',
          'userId',
          'authorName',
          'rating',
          'title',
          'comment',
          'verifiedPurchase',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.reviewId is string
        && data.reviewId.size() >= 5
        && data.reviewId.size() <= 128
        && data.reviewId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.reviewId == reviewId
        && data.collectionName is string
        && data.collectionName.size() <= 32
        && (data.collectionName == 'books' || data.collectionName == 'ExamPackDocument')
        && data.itemId is string
        && data.itemId.size() >= 1
        && data.itemId.size() <= 64
        && data.itemId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId is string
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && data.targetKey is string
        && data.targetKey.size() >= 3
        && data.targetKey.size() <= 100
        && data.targetKey.matches('^[a-zA-Z0-9_\\-]+$')
        && data.targetKey == data.collectionName + '_' + data.itemId
        && data.reviewId == data.collectionName + '_' + data.itemId + '_' + data.userId
        && data.urlSlug is string
        && data.urlSlug.size() >= 1
        && data.urlSlug.size() <= 200
        && data.urlSlug.matches('^[a-z0-9\\-]+$')
        && data.authorName is string
        && data.authorName.size() >= 1
        && data.authorName.size() <= 80
        && (!('title' in data) || (data.title is string && data.title.size() >= 1 && data.title.size() <= 120))
        && data.comment is string
        && data.comment.size() >= 10
        && data.comment.size() <= 2000
        && data.rating is int
        && data.rating >= 1
        && data.rating <= 5
        && data.verifiedPurchase is bool
        && data.status is string
        && data.status.size() <= 16
        && data.status == 'published'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPerformanceInsights(insights) {
      return insights is map
        && insights.keys().hasAll([
          'pacingVerdict',
          'negativeMarkingImpactPct',
          'slowQuestionsCount',
          'markedUnattemptedCount',
          'diagnosticSummary',
          'actionableTakeaways'
        ])
        && insights.keys().hasOnly([
          'strongestSectionTitle',
          'strongestSectionAccuracyPct',
          'focusSectionTitle',
          'focusSectionAccuracyPct',
          'pacingVerdict',
          'negativeMarkingImpactPct',
          'slowQuestionsCount',
          'markedUnattemptedCount',
          'diagnosticSummary',
          'actionableTakeaways'
        ])
        && (!('strongestSectionTitle' in insights) || (insights.strongestSectionTitle is string && insights.strongestSectionTitle.size() <= 200))
        && (!('strongestSectionAccuracyPct' in insights) || ((insights.strongestSectionAccuracyPct is int || insights.strongestSectionAccuracyPct is float) && insights.strongestSectionAccuracyPct >= 0 && insights.strongestSectionAccuracyPct <= 100))
        && (!('focusSectionTitle' in insights) || (insights.focusSectionTitle is string && insights.focusSectionTitle.size() <= 200))
        && (!('focusSectionAccuracyPct' in insights) || ((insights.focusSectionAccuracyPct is int || insights.focusSectionAccuracyPct is float) && insights.focusSectionAccuracyPct >= 0 && insights.focusSectionAccuracyPct <= 100))
        && insights.pacingVerdict is string
        && insights.pacingVerdict.size() >= 1
        && insights.pacingVerdict.size() <= 80
        && (insights.negativeMarkingImpactPct is int || insights.negativeMarkingImpactPct is float)
        && insights.negativeMarkingImpactPct >= 0
        && insights.negativeMarkingImpactPct <= 1000
        && insights.slowQuestionsCount is int
        && insights.slowQuestionsCount >= 0
        && insights.slowQuestionsCount <= 500
        && insights.markedUnattemptedCount is int
        && insights.markedUnattemptedCount >= 0
        && insights.markedUnattemptedCount <= 500
        && insights.diagnosticSummary is string
        && insights.diagnosticSummary.size() >= 1
        && insights.diagnosticSummary.size() <= 1500
        && insights.actionableTakeaways is list
        && insights.actionableTakeaways.size() >= 1
        && insights.actionableTakeaways.size() <= 8
        && insights.actionableTakeaways[0] is string
        && insights.actionableTakeaways[0].size() <= 400;
    }

    function isValidExamAttemptKeysAndIds(data, attemptId) {
      return data.keys().hasAll([
          'attemptId',
          'userId',
          'packId',
          'examSlug',
          'examTitle',
          'setId',
          'setTitle',
          'mode',
          'totalScore',
          'maxScore',
          'scorePct',
          'accuracyPct',
          'attemptPct',
          'totalQuestions',
          'totalAttempted',
          'totalCorrect',
          'totalPartial',
          'totalWrong',
          'totalUnattempted',
          'positiveMarksEarned',
          'negativeMarksLost',
          'totalTimeSpentMs',
          'avgTimePerAttemptedMs',
          'responses',
          'telemetry',
          'markedForReview',
          'sectionBreakdown',
          'questionBreakdown',
          'performanceInsights',
          'startedAtIso',
          'completedAtIso',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'attemptId',
          'userId',
          'packId',
          'examSlug',
          'examTitle',
          'setId',
          'setTitle',
          'mode',
          'totalScore',
          'maxScore',
          'scorePct',
          'accuracyPct',
          'attemptPct',
          'totalQuestions',
          'totalAttempted',
          'totalCorrect',
          'totalPartial',
          'totalWrong',
          'totalUnattempted',
          'positiveMarksEarned',
          'negativeMarksLost',
          'totalTimeSpentMs',
          'avgTimePerAttemptedMs',
          'responses',
          'telemetry',
          'markedForReview',
          'sectionBreakdown',
          'questionBreakdown',
          'performanceInsights',
          'perceivedDifficulty',
          'pacingFeedback',
          'reflectionNote',
          'startedAtIso',
          'completedAtIso',
          'createdAt',
          'updatedAt'
        ])
        && data.attemptId is string
        && data.attemptId.size() >= 5
        && data.attemptId.size() <= 128
        && data.attemptId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.attemptId == attemptId
        && data.userId is string
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && data.packId is string
        && data.packId.size() >= 1
        && data.packId.size() <= 128
        && data.packId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.examSlug is string
        && data.examSlug.size() >= 1
        && data.examSlug.size() <= 200
        && data.examSlug.matches('^[a-z0-9\\-]+$')
        && data.examTitle is string
        && data.examTitle.size() >= 1
        && data.examTitle.size() <= 300
        && data.setId is string
        && data.setId.size() >= 1
        && data.setId.size() <= 128
        && data.setId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.setTitle is string
        && data.setTitle.size() >= 1
        && data.setTitle.size() <= 300
        && data.mode is string
        && data.mode.size() <= 16
        && (data.mode == 'trial' || data.mode == 'full');
    }

    function isValidExamAttemptScoresAndCounts(data) {
      return (data.totalScore is int || data.totalScore is float)
        && data.totalScore >= -10000
        && data.totalScore <= 10000
        && (data.maxScore is int || data.maxScore is float)
        && data.maxScore >= 0
        && data.maxScore <= 10000
        && (data.scorePct is int || data.scorePct is float)
        && data.scorePct >= 0
        && data.scorePct <= 100
        && (data.accuracyPct is int || data.accuracyPct is float)
        && data.accuracyPct >= 0
        && data.accuracyPct <= 100
        && (data.attemptPct is int || data.attemptPct is float)
        && data.attemptPct >= 0
        && data.attemptPct <= 100
        && data.totalQuestions is int
        && data.totalQuestions >= 1
        && data.totalQuestions <= 500
        && data.totalAttempted is int
        && data.totalAttempted >= 0
        && data.totalAttempted <= 500
        && data.totalCorrect is int
        && data.totalCorrect >= 0
        && data.totalCorrect <= 500
        && data.totalPartial is int
        && data.totalPartial >= 0
        && data.totalPartial <= 500
        && data.totalWrong is int
        && data.totalWrong >= 0
        && data.totalWrong <= 500
        && data.totalUnattempted is int
        && data.totalUnattempted >= 0
        && data.totalUnattempted <= 500
        && (data.positiveMarksEarned is int || data.positiveMarksEarned is float)
        && data.positiveMarksEarned >= 0
        && data.positiveMarksEarned <= 10000
        && (data.negativeMarksLost is int || data.negativeMarksLost is float)
        && data.negativeMarksLost >= 0
        && data.negativeMarksLost <= 10000
        && data.totalTimeSpentMs is int
        && data.totalTimeSpentMs >= 0
        && data.totalTimeSpentMs <= 86400000
        && data.avgTimePerAttemptedMs is int
        && data.avgTimePerAttemptedMs >= 0
        && data.avgTimePerAttemptedMs <= 86400000;
    }

    function isValidExamAttemptPayloadsAndFeedback(data) {
      return data.responses is map
        && data.responses.size() <= 500
        && data.telemetry is map
        && data.telemetry.size() <= 500
        && data.markedForReview is map
        && data.markedForReview.size() <= 500
        && data.sectionBreakdown is list
        && data.sectionBreakdown.size() >= 1
        && data.sectionBreakdown.size() <= 30
        && data.sectionBreakdown[0] is map
        && data.sectionBreakdown[0].size() <= 20
        && data.questionBreakdown is list
        && data.questionBreakdown.size() >= 1
        && data.questionBreakdown.size() <= 500
        && data.questionBreakdown[0] is map
        && data.questionBreakdown[0].size() <= 20
        && isValidPerformanceInsights(data.performanceInsights)
        && (!('perceivedDifficulty' in data) || (data.perceivedDifficulty is string && data.perceivedDifficulty.size() <= 24 && (data.perceivedDifficulty == 'easy' || data.perceivedDifficulty == 'moderate' || data.perceivedDifficulty == 'challenging' || data.perceivedDifficulty == 'tough')))
        && (!('pacingFeedback' in data) || (data.pacingFeedback is string && data.pacingFeedback.size() <= 24 && (data.pacingFeedback == 'comfortable' || data.pacingFeedback == 'balanced' || data.pacingFeedback == 'rushed' || data.pacingFeedback == 'time_shortage')))
        && (!('reflectionNote' in data) || (data.reflectionNote is string && data.reflectionNote.size() <= 2000))
        && data.startedAtIso is string
        && data.startedAtIso.size() >= 10
        && data.startedAtIso.size() <= 64
        && data.completedAtIso is string
        && data.completedAtIso.size() >= 10
        && data.completedAtIso.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserExamAttempt(data, attemptId) {
      return isValidExamAttemptKeysAndIds(data, attemptId)
        && isValidExamAttemptScoresAndCounts(data)
        && isValidExamAttemptPayloadsAndFeedback(data);
    }

    // Connection Probe Read-Only Document
    match /test/connection {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    // Read-Only Public Catalog: Books
    match /books/{bookId} {
      allow get: if isValidId(bookId)
        && resource.data.isPublished == true
        && resource.data.isDeleted == false;
      allow list: if resource.data.isPublished == true
        && resource.data.isDeleted == false;
      allow create, update, delete: if false;
    }

    // Read-Only Public Catalog: ExamPackDocument
    match /ExamPackDocument/{examId} {
      allow get: if isValidId(examId)
        && resource.data.isPublished == true
        && resource.data.isDeleted == false;
      allow list: if resource.data.isPublished == true
        && resource.data.isDeleted == false;
      allow create, update, delete: if false;
    }

    // Public Non-PII Ratings & Reviews (1 Review per User per Item)
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId)
        && resource.data.status == 'published';

      allow list: if resource.data.status == 'published';

      allow create: if isVerifiedOwner(incoming().userId)
        && isValidId(reviewId)
        && isValidItemReview(incoming(), reviewId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && hasParentUser(request.auth.uid)
        && hasValidReviewPurchaseProof(incoming());

      allow update: if (
        isVerifiedOwner(existing().userId)
        && isValidId(reviewId)
        && isValidItemReview(incoming(), reviewId)
        && incoming().reviewId == existing().reviewId
        && incoming().targetKey == existing().targetKey
        && incoming().collectionName == existing().collectionName
        && incoming().itemId == existing().itemId
        && incoming().urlSlug == existing().urlSlug
        && incoming().userId == existing().userId
        && incoming().status == existing().status
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: EditReviewContent
          incoming().diff(existing()).affectedKeys().hasOnly([
            'authorName',
            'rating',
            'title',
            'comment',
            'verifiedPurchase',
            'updatedAt'
          ])
        )
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && hasValidReviewPurchaseProof(incoming())
      );

      allow delete: if isVerifiedOwner(existing().userId)
        && isValidId(reviewId);
    }

    // Owner-Scoped User Workspace & Subcollections
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if (
        isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: UpdatePreferredView
          incoming().diff(existing()).affectedKeys().hasOnly(['preferredView', 'updatedAt'])
          ||
          // Action: SyncProfileDetails
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'preferredView', 'updatedAt'])
        )
      );

      allow delete: if isVerifiedOwner(userId) && isValidId(userId);

      // Split-Collection PII Isolation
      match /private/{infoId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidId(infoId)
          && infoId == 'contact'
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/users/$(userId));
        allow list: if false;

        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(infoId)
          && infoId == 'contact'
          && isValidUserPrivateInfo(incoming())
          && incoming().updatedAt == request.time
          && hasParentUser(userId);

        allow update: if (
          isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(infoId)
          && infoId == 'contact'
          && isValidUserPrivateInfo(incoming())
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId))
        );

        allow delete: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(infoId);
      }

      // Immutable Entitlement Records (Terminal State Locked)
      match /purchases/{purchaseId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidId(purchaseId)
          && request.auth.uid == userId
          && resource.data.userId == request.auth.uid
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if isSignedIn()
          && request.auth.uid == userId
          && resource.data.userId == request.auth.uid;

        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(purchaseId)
          && isValidUserPurchase(incoming(), purchaseId)
          && incoming().createdAt == request.time
          && hasParentUser(userId);

        allow update, delete: if false;
      }

      // Active Shopping Cart Sync
      match /cart/{cartKey} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidId(cartKey)
          && request.auth.uid == userId
          && resource.data.userId == request.auth.uid
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if isSignedIn()
          && request.auth.uid == userId
          && resource.data.userId == request.auth.uid;

        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(cartKey)
          && isValidUserCartItem(incoming(), cartKey)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasParentUser(userId);

        allow update: if (
          isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(cartKey)
          && isValidUserCartItem(incoming(), cartKey)
          && incoming().cartKey == existing().cartKey
          && incoming().userId == existing().userId
          && incoming().itemId == existing().itemId
          && incoming().collectionName == existing().collectionName
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['listPrice', 'buyPrice', 'title', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId))
        );

        allow delete: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(cartKey);
      }

      // Saved Wishlist Items Sync
      match /wishlist/{wishlistKey} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidId(wishlistKey)
          && request.auth.uid == userId
          && resource.data.userId == request.auth.uid
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if isSignedIn()
          && request.auth.uid == userId
          && resource.data.userId == request.auth.uid;

        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(wishlistKey)
          && isValidUserWishlistItem(incoming(), wishlistKey)
          && incoming().createdAt == request.time
          && hasParentUser(userId);

        allow update: if false;

        allow delete: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(wishlistKey);
      }

      // Historical Exam Set Attempts, Telemetry, Solution Review Outcomes & Learner Feedback
      match /examAttempts/{attemptId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidId(attemptId)
          && request.auth.uid == userId
          && resource.data.userId == request.auth.uid
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if isSignedIn()
          && request.auth.uid == userId
          && resource.data.userId == request.auth.uid;

        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(attemptId)
          && isValidUserExamAttempt(incoming(), attemptId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasParentUser(userId);

        allow update: if (
          isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(attemptId)
          && isValidUserExamAttempt(incoming(), attemptId)
          && incoming().attemptId == existing().attemptId
          && incoming().userId == existing().userId
          && incoming().packId == existing().packId
          && incoming().examSlug == existing().examSlug
          && incoming().setId == existing().setId
          && incoming().mode == existing().mode
          && incoming().totalScore == existing().totalScore
          && incoming().maxScore == existing().maxScore
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            // Action: SaveAttemptFeedback
            incoming().diff(existing()).affectedKeys().hasOnly([
              'perceivedDifficulty',
              'pacingFeedback',
              'reflectionNote',
              'updatedAt'
            ])
          )
          && exists(/databases/$(database)/documents/users/$(userId))
        );

        allow delete: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(attemptId);
      }
    }
  }
}
