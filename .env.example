# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical HTTPS origin for SSR metadata, sitemaps, and OpenGraph URLs.
APP_URL="https://examdash.app"

# NEXT_PUBLIC_APP_VERSION: Additive API v1 compatibility version header.
NEXT_PUBLIC_APP_VERSION="1.0.0"
