# APP_URL: Canonical HTTPS origin for SSR metadata, sitemaps, OpenGraph, and production payment notes.
APP_URL="https://exam-dash.com"

# CANONICAL_ORIGIN: Optional explicit canonical origin override (defaults to APP_URL / https://exam-dash.com).
CANONICAL_ORIGIN="https://exam-dash.com"

# NEXT_PUBLIC_API_BASE: Empty string ("") on Web SSR; "https://exam-dash.com" in Capacitor static shell.
NEXT_PUBLIC_API_BASE=""

# NEXT_PUBLIC_APP_VERSION: Additive API v1 compatibility version header.
NEXT_PUBLIC_APP_VERSION="1.0.0"

# RAZORPAY_KEY_ID: Live Razorpay Key ID (e.g. rzp_live_...) read on the server (NEXT_PUBLIC_RAZORPAY_KEY_ID is also accepted at runtime).
RAZORPAY_KEY_ID=""

# RAZORPAY_KEY_SECRET: Live Razorpay Key Secret (strictly server-side for order creation and HMAC SHA-256 verification).
RAZORPAY_KEY_SECRET=""

# ASSET_GRANT_SECRET: Optional dedicated server-side HMAC secret for short-lived signed library stream links (falls back to RAZORPAY_KEY_SECRET if unset).
ASSET_GRANT_SECRET=""

# INDEXNOW_KEY: Optional 8-128 char alphanumeric IndexNow domain key (serves /{INDEXNOW_KEY}.txt automatically when set).
INDEXNOW_KEY=""

# SEO_WEBHOOK_SECRET: Server-side Bearer secret for POST /api/v1/seo/publish (and /api/v1/seo/indexnow) to purge Next.js caches, pre-warm live URLs ahead of bots, and push IndexNow URL batches.
SEO_WEBHOOK_SECRET=""



