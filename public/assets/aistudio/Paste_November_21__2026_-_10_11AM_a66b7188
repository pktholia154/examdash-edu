// 2. SVG SANITIZER & CODE + LATEX (\ce) + MARKDOWN RENDERER
// ============================================================================
function sanitizeSvg(raw: string, allowForeignObject = false): string {
  let clean = String(raw || "")
    .replace(/<(?:script|iframe|object|embed|link|meta|animate\w*|set)\b[\s\S]*?(?:<\/(?:script|iframe|object|embed|link|meta|animate\w*|set)>|\/>)/gi, "")
    .replace(/\son[a-z]+\s*=\s*(?:"[^"]*"|'[^']*'|[^\s>]+)/gi, "")
    .replace(/(?:href|xlink:href|src|action)\s*=\s*(?:"\s*(?:javascript|vbscript|data:text\/html)[^"]*"|'\s*(?:javascript|vbscript|data:text\/html)[^']*')/gi, "");

  if (!allowForeignObject) {
    clean = clean.replace(/<foreignObject[\s\S]*?>[\s\S]*?<\/foreignObject>/gi, "");
  }
  return clean;
}

const ESC_DOLLAR = "\uE000";

function renderFormattedText(plain: string, keyPrefix: string): React.ReactNode {
  const restored = plain.replaceAll(ESC_DOLLAR, "$");
  const tokens = restored.split(/(\*\*[^*\n]+?\*\*|__[^_\n]+?__|\*(?!\s)(?:[^*\n]*?[^\s*\n])?\*)/g);

  return tokens.map((part, idx) => {
    if (part.startsWith("**") && part.endsWith("**") && part.length > 4) {
      return <strong key={`${keyPrefix}-b-${idx}`} className="font-semibold text-slate-900">{part.slice(2, -2)}</strong>;
    }
    if (part.startsWith("__") && part.endsWith("__") && part.length > 4) {
      return <u key={`${keyPrefix}-u-${idx}`} className="underline decoration-slate-700 decoration-2 underline-offset-4">{part.slice(2, -2)}</u>;
    }
    if (part.startsWith("*") && part.endsWith("*") && part.length > 2) {
      return <em key={`${keyPrefix}-i-${idx}`} className="italic">{part.slice(1, -1)}</em>;
    }
    return part.split("\n").map((line, lIdx, arr) => (
      <React.Fragment key={`${keyPrefix}-l-${idx}-${lIdx}`}>
        {line}
        {lIdx < arr.length - 1 && <br />}
      </React.Fragment>
    ));
  });
}

export function defaultRenderLatex(input: unknown): React.ReactNode {
  if (input === null || input === undefined || input === "") return null;
  const raw = String(input);

  // 1. Isolate code blocks & inline code first (protects C pointers, SQL, $, *)
  const codeParts = raw.split(/(```[\s\S]*?```|`[^`\n]+`)/g);

  return codeParts.map((seg, cIdx) => {
    if (seg.startsWith("```") && seg.endsWith("```") && seg.length >= 6) {
      const code = seg.slice(3, -3).replace(/^[a-zA-Z0-9_+-]*\r?\n/, "");
      return (
        <pre key={`cb-${cIdx}`} className="my-2 overflow-x-auto rounded-lg bg-slate-900 p-3 font-mono text-xs leading-relaxed text-slate-100">
          <code>{code}</code>
        </pre>
      );
    }
    if (seg.startsWith("`") && seg.endsWith("`") && seg.length >= 2) {
      return (
        <code key={`ic-${cIdx}`} className="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-xs font-medium text-slate-800">
          {seg.slice(1, -1)}
        </code>
      );
    }

    // 2. Protect escaped \$ then tokenize display ($$...$$) & inline ($...$) LaTeX
    const safeSeg = seg.replace(/\\\$/g, ESC_DOLLAR);
    const mathParts = safeSeg.split(/(\$\$[\s\S]+?\$\$|\$(?!\s)(?:[^$\n]*?[^\s$\n])\$)/g);

    return (
      <React.Fragment key={`seg-${cIdx}`}>
        {mathParts.map((mToken, mIdx) => {
          if (mToken.startsWith("$$") && mToken.endsWith("$$") && mToken.length > 4) {
            const tex = mToken.slice(2, -2).replaceAll(ESC_DOLLAR, "\\$");
            const html = katex.renderToString(tex, { displayMode: true, throwOnError: false });
            return <span key={`dm-${mIdx}`} className="my-2 block overflow-x-auto" dangerouslySetInnerHTML={{ __html: html }} />;
          }
          if (mToken.startsWith("$") && mToken.endsWith("$") && mToken.length >= 3) {
            const tex = mToken.slice(1, -1).replaceAll(ESC_DOLLAR, "\\$");
            const html = katex.renderToString(tex, { displayMode: false, throwOnError: false });
            return <span key={`im-${mIdx}`} dangerouslySetInnerHTML={{ __html: html }} />;
          }
          return renderFormattedText(mToken, `${cIdx}-${mIdx}`);
        })}
      </React.Fragment>
    );
  });
}

