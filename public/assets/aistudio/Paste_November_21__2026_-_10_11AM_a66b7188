// 3. CLIENT DIAGRAM MOUNT (Mermaid FSM/Flowcharts & SMILES Molecules/Reactions)
// ============================================================================
function DeclarativeDiagramMount({ type, data }: { type: "smiles" | "mermaid"; data: string }) {
  const baseId = useId().replace(/[^a-zA-Z0-9_-]/g, "_");
  const svgRef = useRef<SVGSVGElement | null>(null);
  const [mermaidSvg, setMermaidSvg] = useState<string>("");
  const [smilesError, setSmilesError] = useState<boolean>(false);

  useEffect(() => {
    let active = true;

    if (type === "mermaid" && data) {
      import("mermaid")
        .then(async (m) => {
          const mermaid = m.default;
          mermaid.initialize({
            startOnLoad: false,
            suppressErrorRendering: true,
            theme: "neutral",
            securityLevel: "strict",
            flowchart: { htmlLabels: false },
          });
          const renderId = `mmd_${baseId}_${++mermaidRenderSeq}`;
          const { svg } = await mermaid.render(renderId, String(data));
          if (active) setMermaidSvg(sanitizeSvg(svg, true));
        })
        .catch(() => {
          if (active) setMermaidSvg("");
        });
    } else if (type === "smiles" && data && svgRef.current) {
      setSmilesError(false);
      svgRef.current.innerHTML = "";
      import("smiles-drawer")
        .then((mod: any) => {
          const SD = mod.default || mod;
          if (!active || !svgRef.current) return;
          if (SD.SmiDrawer) {
            const smiDrawer = new SD.SmiDrawer({ width: 260, height: 160 });
            smiDrawer.draw(String(data), svgRef.current, "light", undefined, () => {
              if (active) setSmilesError(true);
            });
          } else {
            const drawer = new SD.SvgDrawer({ width: 260, height: 160 });
            SD.parse(
              String(data),
              (tree: any) => {
                if (active && svgRef.current) {
                  svgRef.current.innerHTML = "";
                  drawer.draw(tree, svgRef.current, "light");
                }
              },
              () => {
                if (active) setSmilesError(true);
              }
            );
          }
        })
        .catch(() => {
          if (active) setSmilesError(true);
        });
    }

    return () => {
      active = false;
    };
  }, [type, data, baseId]);

  if (type === "mermaid") {
    return mermaidSvg ? (
      <div className="flex justify-center overflow-x-auto py-2 [&>svg]:h-auto [&>svg]:max-w-full" dangerouslySetInnerHTML={{ __html: mermaidSvg }} />
    ) : (
      <pre className="overflow-x-auto rounded bg-slate-50 p-2 text-xs text-slate-600">{data}</pre>
    );
  }

  if (smilesError) {
    return <code className="block rounded bg-slate-50 p-2 text-xs text-slate-700">{data}</code>;
  }

  return (
    <div className="flex justify-center overflow-x-auto py-1">
      <svg ref={svgRef} viewBox="0 0 260 160" className="h-auto max-h-40 w-full max-w-[260px]" />
    </div>
  );
}

// ============================================================================
// 4. SINGLE VISUAL CARD (Chart, Merged-Header Table, SVG, Mermaid, SMILES, Image)
// ============================================================================
function normalizeCell(cell: TableCellInput): TableCellObject {
  if (cell !== null && typeof cell === "object" && "text" in cell) return cell;
  return { text: cell === null || cell === undefined ? "" : String(cell) };
}

export function SingleVisualCard({
  visual,
  renderLatex = defaultRenderLatex,
}: {
  visual: VisualBlock;
  renderLatex?: (txt: unknown) => React.ReactNode;
}) {
  if (!visual || typeof visual !== "object") return null;

  const isNumericScatterX =
    visual.type === "chart" &&
    visual.chartType === "scatter" &&
    typeof visual.data?.[0]?.[visual.xAxisKey] === "number";

  const headerRows: TableCellInput[][] =
    visual.type === "table" && Array.isArray(visual.headers) && visual.headers.length > 0
      ? Array.isArray(visual.headers[0])
        ? (visual.headers as TableCellInput[][])
        : [visual.headers as TableCellInput[]]
      : [];

  return (
    <div className="my-2.5 min-w-0 rounded-xl border border-slate-200 bg-white p-3.5 shadow-sm">
      {visual.title && (
        <h4 className="mb-2.5 border-b pb-1.5 text-sm font-bold text-slate-800">{renderLatex(visual.title)}</h4>
      )}

      {visual.type === "chart" && Array.isArray(visual.data) && (
        <div className="h-72 w-full min-w-0">
          <ResponsiveContainer width="100%" height="100%">
            {visual.chartType === "pie" ? (
              <PieChart>
                <Pie
                  data={visual.data}
                  dataKey={visual.series?.[0]?.key || "value"}
                  nameKey={visual.xAxisKey || "name"}
                  cx="50%"
                  cy="50%"
                  outerRadius={82}
                  label={({ name, value }) => `${name}: ${value}`}
                >
                  {visual.data.map((_, i) => (
                    <Cell key={i} fill={COLORS[i % COLORS.length]} />
                  ))}
                </Pie>
                <Tooltip />
                <Legend />
              </PieChart>
            ) : visual.chartType === "radar" ? (
              <RadarChart data={visual.data}>
                <PolarGrid />
                <PolarAngleAxis dataKey={visual.xAxisKey} />
                <PolarRadiusAxis />
                {(visual.series || []).map((s, i) => (
                  <Radar
                    key={s.key || i}
                    name={s.label || s.key}
                    dataKey={s.key}
                    stroke={COLORS[i % COLORS.length]}
                    fill={COLORS[i % COLORS.length]}
                    fillOpacity={0.3}
                  />
                ))}
                <Legend />
                <Tooltip />
              </RadarChart>
            ) : (
              <ComposedChart data={visual.data}>
                <CartesianGrid strokeDasharray="3 3" />
                <XAxis
                  dataKey={visual.xAxisKey}
                  type={isNumericScatterX ? "number" : "category"}
                  domain={isNumericScatterX ? ["auto", "auto"] : undefined}
                  label={visual.xAxisLabel ? { value: visual.xAxisLabel, position: "insideBottom", offset: -4, fontSize: 11 } : undefined}
                />
                <YAxis
                  yAxisId="left"
                  orientation="left"
                  label={visual.yAxisLabel ? { value: visual.yAxisLabel, angle: -90, position: "insideLeft", fontSize: 11 } : undefined}
                />
                {(visual.series || []).some((s) => s.yAxis === "right") && (
                  <YAxis
                    yAxisId="right"
                    orientation="right"
                    label={visual.rightYAxisLabel ? { value: visual.rightYAxisLabel, angle: 90, position: "insideRight", fontSize: 11 } : undefined}
                  />
                )}
                <Tooltip />
                <Legend />
                {(visual.series || []).map((s, i) => {
                  const yAxisId = s.yAxis || "left";
                  const color = COLORS[i % COLORS.length];
                  const kind = s.type || visual.chartType;

                  if (kind === "scatter") {
                    return <Scatter key={s.key || i} yAxisId={yAxisId} name={s.label} dataKey={s.key} fill={color} />;
                  }
                  if (kind === "line") {
                    return <Line key={s.key || i} yAxisId={yAxisId} type="monotone" dataKey={s.key} name={s.label} stroke={color} strokeWidth={2.5} />;
                  }
                  if (kind === "area") {
                    return <Area key={s.key || i} yAxisId={yAxisId} type="monotone" dataKey={s.key} name={s.label} stroke={color} fill={color} fillOpacity={0.25} />;
                  }
                  return (
                    <Bar
                      key={s.key || i}
                      yAxisId={yAxisId}
                      dataKey={s.key}
                      name={s.label}
                      stackId={visual.chartType === "stacked_bar" ? "stack" : undefined}
                      fill={color}
                    />
                  );
                })}
              </ComposedChart>
            )}
          </ResponsiveContainer>
        </div>
      )}

      {visual.type === "table" && (
        <div className="overflow-x-auto">
          <table className="w-full border-collapse text-left text-sm">
            {headerRows.length > 0 && (
              <thead>
                {headerRows.map((hRow, rIdx) => (
                  <tr key={rIdx} className="bg-slate-100">
                    {hRow.map((rawCell, cIdx) => {
                      const c = normalizeCell(rawCell);
                      const alignCls = c.align === "center" ? "text-center" : c.align === "right" ? "text-right" : "text-left";
                      return (
                        <th key={cIdx} colSpan={c.colSpan} rowSpan={c.rowSpan} className={`border border-slate-300 px-3 py-2 font-semibold text-slate-800 ${alignCls}`}>
                          {renderLatex(c.text)}
                        </th>
                      );
                    })}
                  </tr>
                ))}
              </thead>
            )}
            <tbody>
              {(visual.rows || []).map((row, rIdx) => (
                <tr key={rIdx} className="even:bg-slate-50">
                  {(row || []).map((rawCell, cIdx) => {
                    const c = normalizeCell(rawCell);
                    const alignCls = c.align === "center" ? "text-center" : c.align === "right" ? "text-right" : "text-left";
                    return (
                      <td key={cIdx} colSpan={c.colSpan} rowSpan={c.rowSpan} className={`border border-slate-300 px-3 py-2 text-slate-700 ${alignCls}`}>
                        {renderLatex(c.text)}
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {visual.type === "svg" && visual.data && (
        <div
          className="overflow-x-auto py-2 [&>svg]:mx-auto [&>svg]:block [&>svg]:h-auto [&>svg]:max-h-80 [&>svg]:w-full [&>svg]:max-w-xl"
          dangerouslySetInnerHTML={{ __html: sanitizeSvg(visual.data, false) }}
        />
      )}

      {(visual.type === "smiles" || visual.type === "mermaid") && visual.data && (
        <DeclarativeDiagramMount type={visual.type} data={String(visual.data)} />
      )}

      {visual.type === "image" && visual.data && (
        <div className="flex justify-center py-2">
          <img src={visual.data} alt={visual.alt || visual.title || "Exam diagram"} loading="lazy" className="max-h-80 w-auto rounded-lg object-contain" />
        </div>
      )}

      {visual.note && (
        <div className="mt-2.5 rounded border-l-4 border-amber-400 bg-amber-50/70 px-3 py-1.5 text-xs text-slate-700">
          {renderLatex(visual.note)}
        </div>
      )}
    </div>
  );
}

// ============================================================================
// 5. MULTI-VISUAL CONTENT BLOCK (Safe Dynamic {{id}} Interleaving + Fallback)
// ============================================================================
export function MultiVisualContentBlock({
  text,
  visuals = [],
  renderLatex = defaultRenderLatex,
}: {
  text?: string | null;
  visuals?: VisualBlock[] | null;
  renderLatex?: (txt: unknown) => React.ReactNode;
}) {
  const safeVisuals = Array.isArray(visuals) ? visuals.filter(Boolean) : [];
  const visualMap = new Map(safeVisuals.map((v) => [v.id, v]));
  const renderedIds = new Set<string>();

  let parts: string[] = text ? [String(text)] : [];
  if (text && visualMap.size > 0) {
    const escapedIds = Array.from(visualMap.keys()).map((id) => id.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"));
    const splitRegex = new RegExp(`(\\{\\{(?:${escapedIds.join("|")})\\}\\})`, "g");
    parts = String(text).split(splitRegex);
  }

  return (
    <div className="space-y-2.5">
      {parts.map((part, idx) => {
        const match = part.match(/^\{\{(.+)\}\}$/);
        if (match && visualMap.has(match[1])) {
          const target = visualMap.get(match[1])!;
          renderedIds.add(target.id);
          return <SingleVisualCard key={`v-${idx}`} visual={target} renderLatex={renderLatex} />;
        }
        const trimmed = part.replace(/^\r?\n+|\r?\n+$/g, "");
        return trimmed ? (
          <div key={`t-${idx}`} className="leading-relaxed text-slate-800">
            {renderLatex(trimmed)}
          </div>
        ) : null;
      })}

      {safeVisuals
        .filter((v) => !renderedIds.has(v.id))
        .map((v, idx) => (
          <SingleVisualCard key={v.id || `rem-${idx}`} visual={v} renderLatex={renderLatex} />
        ))}
    </div>
  );
}

// ============================================================================
// 6. ATTEMPT TRACKING, RESPONSE BLOCK (Exam + Review Mode) & GRADING ENGINE
// ============================================================================
export function isQuestionAttempted(question: { type: string }, rawAnswer: unknown): boolean {
  if (rawAnswer === null || rawAnswer === undefined) return false;
  if (question.type === "MSQ") {
    return Array.isArray(rawAnswer) && rawAnswer.some((v) => String(v).trim() !== "");
  }
  const str = String(rawAnswer).trim();
  if (str === "" || (question.type === "NAT" && (str === "-" || str === "." || str === "-."))) {
    return false;
  }
  return question.type === "NAT" ? Number.isFinite(Number(str)) : true;
}

export function hasActiveSlot(question: { type: string }, rawAnswer: unknown): boolean {
  if (isQuestionAttempted(question, rawAnswer)) return true;
  if (question.type === "NAT" && rawAnswer !== null && rawAnswer !== undefined) {
    return String(rawAnswer).trim() !== "";
  }
  return false;
}

export function isQuestionLockedBySectionCap(
  section: Pick<ExamSection, "maxAttempts" | "questions">,
  questionId: string,
  sectionResponses: Record<string, unknown>
): boolean {
  const cap = section.maxAttempts ? Number(section.maxAttempts) : null;
  if (!cap) return false;
  let activeCount = 0;
  let currentHasSlot = false;
  for (const q of section.questions || []) {
    const active = hasActiveSlot(q, sectionResponses[q.id]);
    if (active) activeCount++;
    if (q.id === questionId && active) currentHasSlot = true;
  }
  return activeCount >= cap && !currentHasSlot;
}

export function QuestionResponseBlock({
  question,
  userAnswer,
  onChange,
  mode = "exam",
  isAttemptCapReached = false,
  showVirtualKeypad = true,
  renderLatex = defaultRenderLatex,
}: {
  question: ExamQuestion;
  userAnswer: unknown;
  onChange: (val: unknown) => void;
  mode?: "exam" | "review";
  isAttemptCapReached?: boolean;
  showVirtualKeypad?: boolean;
  renderLatex?: (txt: unknown) => React.ReactNode;
}) {
  const isReview = mode === "review";
  const isLocked = isReview || (isAttemptCapReached && !hasActiveSlot(question, userAnswer));

  if (question.type === "NAT") {
    const valStr = userAnswer !== null && userAnswer !== undefined ? String(userAnswer) : "";
    const range = Array.isArray(question.answer) ? question.answer : [question.answer, question.answer];

    const handleNumericInput = (next: string) => {
      if (isLocked) return;
      if (next === "" || /^-?\d*\.?\d*$/.test(next)) onChange(next);
    };

    const handleKeyPress = (key: string) => {
      if (isLocked) return;
      if (key === "CLEAR") return onChange("");
      if (key === "BACKSPACE") return onChange(valStr.slice(0, -1));
      if (key === "-") return onChange(valStr.startsWith("-") ? valStr.slice(1) : "-" + valStr);
      if (key === "." && valStr.includes(".")) return;
      handleNumericInput(valStr + key);
    };

    return (
      <div className="mt-4 space-y-3">
        {!isReview && isLocked && (
          <div className="rounded-lg border border-amber-300 bg-amber-50 p-2.5 text-xs font-medium text-amber-800">
            Section attempt limit reached. Clear an existing response in this section to attempt this question.
          </div>
        )}
        <div className="flex flex-wrap items-center gap-3">
          <div>
            <label className="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-500">
              Numerical Answer:
            </label>
            <input
              type="text"
              inputMode="decimal"
              disabled={isLocked}
              value={valStr}
              onChange={(e) => handleNumericInput(e.target.value)}
              placeholder={isReview ? "Unattempted" : "Enter numerical value"}
              className="w-60 rounded-lg border border-slate-300 px-3 py-2 text-base font-semibold text-slate-900 focus:border-blue-600 focus:outline-none disabled:bg-slate-100"
            />
          </div>
          {isReview && (
            <div className="rounded-lg border border-emerald-300 bg-emerald-50 px-3 py-2 text-xs font-semibold text-emerald-900">
              Accepted Answer:{" "}
              {Number(range[0]) === Number(range[1]) ? range[0] : `${range[0]} to ${range[1]}`}
            </div>
          )}
        </div>

        {!isReview && showVirtualKeypad && !isLocked && (
          <div className="inline-grid grid-cols-4 gap-1.5 rounded-xl border border-slate-200 bg-slate-50 p-2.5">
            {["7", "8", "9", "BACKSPACE", "4", "5", "6", "-", "1", "2", "3", ".", "0", "CLEAR"].map((k) => (
              <button
                key={k}
                type="button"
                onClick={() => handleKeyPress(k)}
                className={`rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 shadow-sm hover:bg-slate-100 ${
                  k === "CLEAR" || k === "BACKSPACE" ? "col-span-2 text-red-600" : ""
                }`}
              >
                {k === "BACKSPACE" ? "⌫" : k}
              </button>
            ))}
          </div>
        )}
      </div>
    );
  }

  const isMSQ = question.type === "MSQ";
  const selectedSet = new Set(
    isMSQ ? (Array.isArray(userAnswer) ? userAnswer.map(String) : []) : userAnswer ? [String(userAnswer)] : []
  );
  const correctSet = new Set(
    isMSQ
      ? (Array.isArray(question.answer) ? question.answer.map(String) : [])
      : [String(question.answer)]
  );

  return (
    <div className="mt-4 space-y-2.5" role={isMSQ ? "group" : "radiogroup"}>
      {!isReview && isLocked && (
        <div className="rounded-lg border border-amber-300 bg-amber-50 p-2.5 text-xs font-medium text-amber-800">
          Section attempt limit reached. Clear an existing response in this section to attempt this question.
        </div>
      )}

      {(question.options || []).map((opt) => {
        const isSelected = selectedSet.has(opt.id);
        const isCorrectOpt = correctSet.has(opt.id);

        const toggleOption = () => {
          if (isLocked) return;
          if (!isMSQ) {
            onChange(isSelected ? null : opt.id);
          } else {
            const next = isSelected
              ? Array.from(selectedSet).filter((id) => id !== opt.id)
              : Array.from(new Set([...selectedSet, opt.id])).sort();
            onChange(next);
          }
        };

        let cardCls = "border-slate-200 bg-white hover:bg-slate-50";
        let badgeCls = "border-slate-300 text-slate-600";

        if (isReview) {
          if (isCorrectOpt && isSelected) {
            cardCls = "border-emerald-600 bg-emerald-50/80 ring-1 ring-emerald-600";
            badgeCls = "border-emerald-600 bg-emerald-600 text-white";
          } else if (isCorrectOpt && !isSelected) {
            cardCls = "border-dashed border-emerald-500 bg-emerald-50/40";
            badgeCls = "border-emerald-600 text-emerald-700";
          } else if (!isCorrectOpt && isSelected) {
            cardCls = "border-rose-600 bg-rose-50/80 ring-1 ring-rose-600";
            badgeCls = "border-rose-600 bg-rose-600 text-white";
          }
        } else if (isSelected) {
          cardCls = "border-blue-600 bg-blue-50/70 ring-1 ring-blue-600";
          badgeCls = "border-blue-600 bg-blue-600 text-white";
        }

        return (
          <div
            key={opt.id}
            role={isMSQ ? "checkbox" : "radio"}
            aria-checked={isSelected}
            aria-disabled={isLocked}
            tabIndex={isLocked ? -1 : 0}
            onClick={toggleOption}
            onKeyDown={(e) => {
              if (!isLocked && (e.key === " " || e.key === "Enter")) {
                e.preventDefault();
                toggleOption();
              }
            }}
            className={`flex w-full cursor-pointer items-start gap-3 rounded-xl border p-3.5 text-left transition select-none ${cardCls} ${
              isLocked ? "cursor-default opacity-90" : ""
            }`}
          >
            <span className={`mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-md border text-xs font-bold ${badgeCls}`}>
              {opt.id}
            </span>
            <div className="min-w-0 flex-1 text-sm">
              <MultiVisualContentBlock text={opt.text} visuals={opt.visuals} renderLatex={renderLatex} />
            </div>
          </div>
        );
      })}
    </div>
  );
}

export function evaluateQuestion(
  question: Pick<ExamQuestion, "type" | "marks" | "answer">,
  userAnswer: unknown
): QuestionEvaluation {
  const { type, marks, answer } = question;
  const correctMarks = Number(marks?.correct ?? 1);
  const wrongPenalty = -Math.abs(Number(marks?.wrong ?? 0));

  if (!isQuestionAttempted(question, userAnswer)) {
    return { status: "UNATTEMPTED", marksAwarded: 0 };
  }

  if (type === "MCQ") {
    const isCorrect = String(userAnswer).trim() === String(answer).trim();
    return {
      status: isCorrect ? "CORRECT" : "WRONG",
      marksAwarded: Number((isCorrect ? correctMarks : wrongPenalty).toFixed(6)),
    };
  }

  if (type === "NAT") {
    const num = Number(String(userAnswer).trim());
    const bounds = Array.isArray(answer)
      ? [Number(answer[0]), Number(answer[1] ?? answer[0])]
      : [Number(answer), Number(answer)];
    if (!Number.isFinite(num) || !Number.isFinite(bounds[0]) || !Number.isFinite(bounds[1])) {
      return { status: "WRONG", marksAwarded: Number(wrongPenalty.toFixed(6)) };
    }
    const min = Math.min(bounds[0], bounds[1]);
    const max = Math.max(bounds[0], bounds[1]);
    const isCorrect = num >= min - 1e-6 && num <= max + 1e-6;
    return {
      status: isCorrect ? "CORRECT" : "WRONG",
      marksAwarded: Number((isCorrect ? correctMarks : wrongPenalty).toFixed(6)),
    };
  }

  if (type === "MSQ") {
    const correctSet = new Set((Array.isArray(answer) ? answer : []).map((v) => String(v).trim()).filter(Boolean));
    const userSet = new Set((Array.isArray(userAnswer) ? userAnswer : []).map((v) => String(v).trim()).filter(Boolean));

    if (correctSet.size === 0 || userSet.size === 0) {
      return { status: "UNATTEMPTED", marksAwarded: 0 };
    }
    for (const opt of userSet) {
      if (!correctSet.has(opt)) {
        return { status: "WRONG", marksAwarded: Number(wrongPenalty.toFixed(6)) };
      }
    }
    if (userSet.size === correctSet.size) {
      return { status: "CORRECT", marksAwarded: Number(correctMarks.toFixed(6)) };
    }
    const partialRate = Number(marks?.partial ?? 0);
    if (partialRate > 0) {
      const awarded = Math.min(userSet.size * partialRate, (userSet.size / correctSet.size) * correctMarks);
      return { status: "PARTIAL", marksAwarded: Number(awarded.toFixed(6)) };
    }
    return { status: "WRONG", marksAwarded: Number(wrongPenalty.toFixed(6)) };
  }

  return { status: "UNATTEMPTED", marksAwarded: 0 };
}

export function evaluateFullExam(
  exam: ExamSet,
  userResponses: Record<string, unknown>
): ExamEvaluationResult {
  let totalScore = 0;
  let computedMaxScore = 0;
  const sectionResults: ExamEvaluationResult["sectionResults"] = {};
  const questionResults: Record<string, QuestionEvaluation> = {};

  for (const section of exam.sections || []) {
    let sectionScore = 0;
    let attempted = 0, correct = 0, partial = 0, wrong = 0, unattempted = 0;
    const cap = section.maxAttempts ? Number(section.maxAttempts) : null;

    const sortedMarks = (section.questions || []).map((q) => Number(q.marks?.correct ?? 0)).sort((a, b) => b - a);
    computedMaxScore += (cap ? sortedMarks.slice(0, cap) : sortedMarks).reduce((acc, v) => acc + v, 0);

    for (const q of section.questions || []) {
      const raw = userResponses[q.id];
      const isAttempt = isQuestionAttempted(q, raw);

      if (isAttempt && cap !== null && attempted >= cap) {
        questionResults[q.id] = { status: "UNATTEMPTED", marksAwarded: 0, ignoredByCap: true };
        unattempted++;
        continue;
      }

      const res = evaluateQuestion(q, raw);
      questionResults[q.id] = res;
      sectionScore += res.marksAwarded;

      if (res.status === "UNATTEMPTED") unattempted++;
      else {
        attempted++;
        if (res.status === "CORRECT") correct++;
        else if (res.status === "PARTIAL") partial++;
        else wrong++;
      }
    }

    sectionResults[section.id] = {
      score: Number(sectionScore.toFixed(2)),
      attempted,
      correct,
      partial,
      wrong,
      unattempted,
    };
    totalScore += sectionScore;
  }

  return {
    totalScore: Number(totalScore.toFixed(2)),
    maxScore: Number((exam.totalMarks || computedMaxScore).toFixed(2)),
    sectionResults,
    questionResults,
  };
}

// ============================================================================
// 7. UNIFIED SPLIT-PANE MULTI-CONTEXT QUESTION WORKSPACE (Exam + Review Mode)
// ============================================================================
export function ExamQuestionWorkspace({
  section,
  question,
  questionNumber,
  sectionResponses,
  onChange,
  mode = "exam",
  showVirtualKeypad = true,
  renderLatex = defaultRenderLatex,
}: {
  section: ExamSection;
  question: ExamQuestion;
  questionNumber?: number;
  sectionResponses: Record<string, unknown>;
  onChange: (questionId: string, nextAnswer: unknown) => void;
  mode?: "exam" | "review";
  showVirtualKeypad?: boolean;
  renderLatex?: (txt: unknown) => React.ReactNode;
}) {
  const resolvedContexts = (question.contextIds || [])
    .map((cid) => (section.contexts || []).find((c) => c.id === cid))
    .filter((c): c is ExamContext => Boolean(c));

  const userAnswer = sectionResponses[question.id];
  const capLocked = isQuestionLockedBySectionCap(section, question.id, sectionResponses);
  const evaluation = mode === "review" ? evaluateQuestion(question, userAnswer) : null;

  return (
    <div className={`grid gap-5 ${resolvedContexts.length > 0 ? "lg:grid-cols-12" : "mx-auto max-w-4xl grid-cols-1"}`}>
      {resolvedContexts.length > 0 && (
        <div className="space-y-4 rounded-2xl border border-slate-200 bg-slate-50/70 p-4 lg:col-span-6 lg:max-h-[78vh] lg:overflow-y-auto">
          {resolvedContexts.map((ctx, idx) => (
            <div key={ctx.id} className={idx > 0 ? "border-t border-slate-200 pt-4" : ""}>
              {ctx.title && (
                <div className="mb-2 inline-block rounded-md bg-blue-100 px-2.5 py-1 text-xs font-bold text-blue-900">
                  {renderLatex(ctx.title)}
                </div>
              )}
              <MultiVisualContentBlock text={ctx.text} visuals={ctx.visuals} renderLatex={renderLatex} />
            </div>
          ))}
        </div>
      )}

      <div className={`rounded-2xl border border-slate-200 bg-white p-5 shadow-sm ${resolvedContexts.length > 0 ? "lg:col-span-6 lg:max-h-[78vh] lg:overflow-y-auto" : ""}`}>
        <div className="mb-3 flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-2.5">
          <div className="flex items-center gap-2">
            {questionNumber !== undefined && (
              <span className="rounded-lg bg-slate-900 px-2.5 py-1 text-xs font-bold text-white">Q{questionNumber}</span>
            )}
            <span className="rounded-md bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700">{question.type}</span>
          </div>
          <div className="flex items-center gap-2 text-xs font-semibold">
            <span className="rounded bg-emerald-50 px-2 py-0.5 text-emerald-700">+{question.marks.correct}</span>
            <span className="rounded bg-rose-50 px-2 py-0.5 text-rose-700">
              {question.marks.wrong === 0 ? "0" : -Math.abs(question.marks.wrong)}
            </span>
            {question.marks.partial > 0 && (
              <span className="rounded bg-amber-50 px-2 py-0.5 text-amber-700">Partial +{question.marks.partial}</span>
            )}
          </div>
        </div>

        <MultiVisualContentBlock text={question.prompt} visuals={question.visuals} renderLatex={renderLatex} />

        <QuestionResponseBlock
          question={question}
          userAnswer={userAnswer}
          onChange={(val) => onChange(question.id, val)}
          mode={mode}
          isAttemptCapReached={capLocked}
          showVirtualKeypad={showVirtualKeypad}
          renderLatex={renderLatex}
        />

        {mode === "review" && evaluation && (
          <div className="mt-5 space-y-3 border-t border-slate-200 pt-4">
            <div className="flex items-center justify-between rounded-lg bg-slate-50 px-3 py-2 text-xs font-bold">
              <span>Status: {evaluation.status}</span>
              <span>Marks Awarded: {Number(evaluation.marksAwarded.toFixed(2))}</span>
            </div>
            {(question.explanation || (question.explanationVisuals && question.explanationVisuals.length > 0)) && (
              <div className="rounded-xl border border-blue-200 bg-blue-50/40 p-4 text-sm">
                <div className="mb-2 text-xs font-bold uppercase tracking-wider text-blue-900">Explanation</div>
                <MultiVisualContentBlock
                  text={question.explanation}
                  visuals={question.explanationVisuals}
                  renderLatex={renderLatex}
                />
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  );
}
