Upgrade sanitizeSvg from Regex to DOMPurify: Regex SVG filters can be bypassed via HTML-encoded attributes inside Capacitor WebViews. Since DOMPurify is already in your core bundle (for the Markdown viewer), replace the regex body of sanitizeSvg with a 4-line DOMPurify call:
Ts
import DOMPurify from "dompurify";
function sanitizeSvg(raw: string, allowForeignObject = false): string {
  return DOMPurify.sanitize(String(raw || ""), {
    USE_PROFILES: { svg: true, svgFilters: true },
    ADD_TAGS: allowForeignObject ? ["foreignObject"] : [],
    FORBID_TAGS: ["script", "iframe", "object", "embed", "animate", "set"],
  });
}
